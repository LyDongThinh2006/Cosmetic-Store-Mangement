skinparam ArrowColor #4A4A4A
skinparam ArrowThickness 1
skinparam actorStyle stickman
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #333333
skinparam usecaseBorderColor #5C5544
